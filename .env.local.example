# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Optional: override the model
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: require a password to open the whole site. Leave empty once accounts are on,
# otherwise visitors hit the browser's password box before they ever see the login screen.
APP_PASSWORD=

# ---------- Firebase accounts (see "Accounts" in README.md) ----------
# Leave these empty to run in local mode: no sign-in, generations aren't counted.

# Web app config (Firebase console → Project settings → General → Your apps → Web app).
# These are public by design; they go to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Google's own sign-in prompt (One Tap): Authentication → Sign-in method → Google → Web SDK configuration → Web client ID.
# Leave empty to use only the built-in sign-in card.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Service account (Project settings → Service accounts → Generate new private key).
# Server-only secrets: never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value on one line, keeping the \n sequences, in double quotes.
FIREBASE_PRIVATE_KEY=
